# Template .env pour PROD sur o2switch (mutualisé)
# Domaine: https://famille.opanoma.fr
#
# IMPORTANT:
# - Ne commit jamais ton vrai .env (ce fichier est un exemple)
# - Mets APP_DEBUG=false en prod

APP_NAME="Famille"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://famille.opanoma.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de données (o2switch MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions / Cache ---
# Sur mutualisé: file est le plus simple et robuste.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=famille.opanoma.fr

CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@famille.opanoma.fr"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- Chat / Broadcast ---
# Sur o2switch, Reverb (WebSocket) est difficile à opérer en 24/7.
# Pour désactiver le temps réel et éviter les erreurs WS:
BROADCAST_CONNECTION=log

# Si tu passes à un provider (Pusher/Ably), tu remplaceras la section ci-dessous.
# (On te le configure quand tu veux.)

# --- Reverb (non recommandé sur mutualisé) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
